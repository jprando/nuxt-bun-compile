{
  "name": "nuxt-bun-compile",
  "version": "0.1.5",
  "description": "Nuxt module that automatically configures Nitro for `bun build --compile`, generating a standalone executable binary from your Nuxt app.",
  "repository": "jprando/nuxt-bun-compile",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./module": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./*": {
      "types": "./dist/types.d.mts",
      "import": "./dist/*"
    }
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "format": "dprint fmt package.json tsconfig.json dprint.json ./src/*.ts ./src/**/*.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@nuxt/kit": "^4.3.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint-config": "^1.14.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.3.1",
    "@nuxt/test-utils": "^4.0.0",
    "@types/bun": "^1.3.9",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "dprint": "^0.51.1",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "nuxt": "^4.3.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": "^1.3.9"
  },
  "trustedDependencies": [
    "dprint"
  ]
}
